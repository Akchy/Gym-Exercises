# Copy to .env.local for development. Both values are public (they ship in the app);
# Row Level Security in deploy/supabase/schema.sql is what protects each user's data.
# Leave them empty to run GymFree as a this-device-only app without sign-in.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Never put the Google client secret or a Supabase secret key (sb_secret_... / service_role) here.
